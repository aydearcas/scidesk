{
  "name": "@scidesk/spell",
  "version": "0.1.0",
  "private": true,
  "description": "SciDesk's spell checker (record 0023): spellbook in WebAssembly, the Hunspell dictionaries it loads and the word rules, for the editor's worker and for Node.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build:wasm": "cargo build --release --manifest-path rust/Cargo.toml --target wasm32-unknown-unknown && node -e \"require('fs').copyFileSync('rust/target/wasm32-unknown-unknown/release/spellwasm.wasm','assets/spellwasm.wasm')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
