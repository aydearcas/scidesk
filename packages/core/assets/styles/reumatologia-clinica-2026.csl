<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" page-range-format="minimal" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="es-ES">
  <info>
    <title>Reumatología Clínica (2026, prototipo de SciDesk)</title>
    <id>http://www.zotero.org/styles/reumatologia-clinica-scidesk-prototype</id>
    <link href="http://www.zotero.org/styles/elsevier-vancouver" rel="template"/>
    <link href="https://www.reumatologiaclinica.org/es-guia-autores" rel="documentation"/>
    <author>
      <name>Richard Karnesky</name>
      <email>karnesky+zotero@gmail.com</email>
    </author>
    <contributor>
      <name>SciDesk (prototype 2 of phase 0)</name>
    </contributor>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <issn>1699-258X</issn>
    <summary>Derived from "Elsevier - Vancouver" to follow the reference examples of the Spanish authors' guide of Reumatología Clínica (read on 21/11/2026): superscript citations, bold volume, en dash in page ranges, italic book title in chapters, web pages and datasets as in the guide. A prototype, not yet submitted to the CSL repository.</summary>
    <updated>2026-11-21T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <!-- The terms follow the language the engine is given (SciDesk: the manuscript's, or the
       one chosen in the program); these blocks only adjust what the guide asks for. -->
  <locale xml:lang="es">
    <date form="text">
      <date-part name="day" suffix=" de "/>
      <date-part name="month" suffix=" de "/>
      <date-part name="year"/>
    </date>
    <terms>
      <!-- the guide uses an en dash (51–9); the Spanish locale has a hyphen -->
      <term name="page-range-delimiter">–</term>
      <term name="accessed">consultada el</term>
      <term name="in press">en prensa</term>
    </terms>
  </locale>
  <locale xml:lang="en">
    <!-- as in the English guide: [accessed 13 March 2023] -->
    <date form="text">
      <date-part name="day" suffix=" "/>
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </locale>
  <macro name="author">
    <names variable="author">
      <name initialize-with="" delimiter=", " delimiter-precedes-last="always" name-as-sort-order="all" sort-separator=" "/>
      <label form="long" prefix=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <name initialize-with="" delimiter=", " delimiter-precedes-last="always" name-as-sort-order="all" sort-separator=" "/>
      <label form="long" prefix=", " suffix="."/>
    </names>
  </macro>
  <macro name="year-date">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text term="no date" form="short"/>
      </else>
    </choose>
  </macro>
  <macro name="publisher">
    <text variable="publisher-place" suffix=": " text-case="title"/>
    <text variable="publisher" suffix="; "/>
    <text macro="year-date"/>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="accessed">
    <group prefix=" [" suffix="]" delimiter=" ">
      <text term="accessed"/>
      <date variable="accessed" form="text"/>
    </group>
  </macro>
  <macro name="doi">
    <text variable="DOI" prefix="https://doi.org/"/>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <group>
        <text variable="citation-number"/>
        <group prefix="(" suffix=")">
          <label variable="locator" form="short" strip-periods="true"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush" et-al-min="7" et-al-use-first="6">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="dataset">
          <text value="[dataset]" suffix=" "/>
        </if>
      </choose>
      <text macro="author" suffix=". "/>
      <choose>
        <if type="webpage post-weblog post" match="any">
          <!-- Title, URL; year [consultada el 13 de marzo de 2003] -->
          <group delimiter="; ">
            <group delimiter=", ">
              <text variable="title"/>
              <text variable="URL"/>
            </group>
            <text macro="year-date"/>
          </group>
          <text macro="accessed"/>
        </if>
        <else-if type="dataset">
          <!-- Title, Publisher, v1; year. DOI -->
          <group delimiter=". ">
            <group delimiter="; ">
              <group delimiter=", ">
                <text variable="title"/>
                <text variable="publisher"/>
                <text variable="version" prefix="v"/>
              </group>
              <text macro="year-date"/>
            </group>
            <text macro="doi"/>
          </group>
        </else-if>
        <else-if type="bill book graphic legal_case legislation motion_picture report song" match="any">
          <group delimiter=". ">
            <text variable="title"/>
            <text variable="volume" prefix="vol. "/>
            <text macro="edition"/>
            <text macro="publisher"/>
            <group>
              <text variable="URL"/>
              <text macro="accessed"/>
            </group>
          </group>
        </else-if>
        <else-if type="chapter paper-conference" match="any">
          <group delimiter=", ">
            <group delimiter=". ">
              <text variable="title"/>
              <group>
                <text term="in" text-case="capitalize-first" suffix=": "/>
                <text macro="editor"/>
              </group>
              <group delimiter=", ">
                <text variable="container-title" form="short" font-style="italic"/>
                <text variable="volume" prefix="vol. "/>
              </group>
              <text macro="edition"/>
            </group>
            <text macro="publisher"/>
            <group delimiter=" ">
              <label variable="page" form="short" plural="never"/>
              <text variable="page"/>
            </group>
          </group>
        </else-if>
        <else-if type="article">
          <!-- preprint (an article with no journal): Title [preprint]. Server; year. DOI -->
          <group delimiter=". ">
            <group delimiter=" ">
              <text variable="title"/>
              <text value="[preprint]"/>
            </group>
            <group delimiter="; ">
              <text variable="publisher"/>
              <text macro="year-date"/>
            </group>
            <text macro="doi"/>
          </group>
        </else-if>
        <else>
          <!-- Title. Abbrev Year;Volume:pages. DOI -->
          <group delimiter=". ">
            <group delimiter=":">
              <group delimiter=" ">
                <group delimiter=". ">
                  <text variable="title"/>
                  <text variable="container-title" form="short" strip-periods="true"/>
                </group>
                <group delimiter=";">
                  <text macro="year-date"/>
                  <text variable="volume" font-weight="bold"/>
                </group>
              </group>
              <text variable="page" form="short"/>
            </group>
            <choose>
              <if variable="volume page" match="none">
                <!-- the term of the language, not the record's own text -->
                <choose>
                  <if variable="status">
                    <text term="in press" text-case="capitalize-first"/>
                  </if>
                </choose>
              </if>
            </choose>
            <text macro="doi"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
